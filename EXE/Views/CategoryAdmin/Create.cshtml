@model EXE.Models.Category
@{
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
	ViewData["Title"] = "Thêm danh mục";
}

<div class="container-fluid py-3">
	<h2 class="mb-4">Thêm danh mục</h2>

	<form method="post" class="bg-white p-4 rounded shadow-sm">
		<div class="mb-3">
			<label class="form-label">Tên danh mục</label>
			<input asp-for="CategoryName" class="form-control" placeholder="Ví dụ: Đặc sản miền Bắc" />
		</div>
		<div class="mb-3">
			<label class="form-label">Mô tả</label>
			<textarea asp-for="Description" class="form-control" rows="3"></textarea>
		</div>
		<div class="d-flex justify-content-between">
			<a href="/CategoryAdmin" class="btn btn-outline-secondary rounded-pill px-4">Quay lại</a>
			<button type="submit" class="btn btn-primary rounded-pill px-4">Lưu</button>
		</div>
	</form>
</div>

