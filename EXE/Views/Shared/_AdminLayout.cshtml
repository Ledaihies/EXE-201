@{
	var title = ViewData["Title"] as string ?? "Quản trị - Nguồn Việt";
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<title>@title</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

	<link href="~/css/bootstrap.min.css" rel="stylesheet" />
	<link href="~/css/style.css" rel="stylesheet" />

	<style>
		body {
			background-color: #f5f7fb;
			font-family: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}

		.admin-shell {
			min-height: 100vh;
			display: grid;
			grid-template-columns: 260px 1fr;
		}

		.admin-sidebar {
			background: #fff;
			border-right: 1px solid rgba(15, 23, 42, 0.06);
		}

		.admin-sidebar .brand {
			padding: 1.25rem 1.5rem;
			border-bottom: 1px solid rgba(15, 23, 42, 0.06);
		}

		.admin-sidebar .brand h3 {
			font-weight: 700;
			color: #16a34a;
			margin: 0;
			font-size: 1.35rem;
		}

		.admin-sidebar .brand small {
			color: #64748b;
		}

		.admin-nav {
			padding: 1rem 0.75rem 1.5rem;
		}

		.admin-nav .nav-section {
			padding: 0.75rem 0.75rem 0.25rem;
			text-transform: uppercase;
			font-size: 0.75rem;
			font-weight: 600;
			color: #94a3b8;
		}

		.admin-nav a {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			padding: 0.55rem 0.9rem;
			margin: 0.1rem 0.55rem;
			border-radius: 999px;
			color: #0f172a;
			text-decoration: none;
			font-size: 0.9rem;
		}

		.admin-nav a i {
			width: 18px;
			text-align: center;
			color: #64748b;
		}

		.admin-nav a.active,
		.admin-nav a:hover {
			background: #ecfdf3;
			color: #166534;
		}

		.admin-nav a.active i,
		.admin-nav a:hover i {
			color: #16a34a;
		}

		.admin-main {
			display: flex;
			flex-direction: column;
			min-height: 100vh;
		}

		.admin-topbar {
			height: 60px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0 1.75rem;
			background: #ffffff;
			border-bottom: 1px solid rgba(15, 23, 42, 0.06);
			position: sticky;
			top: 0;
			z-index: 10;
		}

		.admin-topbar-title {
			font-size: 1rem;
			font-weight: 600;
			color: #0f172a;
		}

		.admin-topbar-sub {
			font-size: 0.8rem;
			color: #94a3b8;
		}

		.admin-topbar-actions a {
			margin-left: 0.5rem;
		}

		.admin-content {
			padding: 1.75rem 1.75rem 2.5rem;
			flex: 1;
		}

		@@media (max-width: 991.98px) {
			.admin-shell {
				grid-template-columns: 1fr;
			}

			.admin-sidebar {
				display: none;
			}
		}
	</style>
</head>
<body>
	<div class="admin-shell">
		<aside class="admin-sidebar">
			<div class="brand">
				<h3>Nguồn Việt</h3>
				<small>Trung tâm quản trị</small>
			</div>
			<nav class="admin-nav">
				<div class="nav-section">Tổng quan</div>
				<a href="/Admin" class="@(Context.Request.Path.StartsWithSegments("/Admin") ? "active" : "")">
					<i class="fas fa-chart-pie"></i>
					Bảng điều khiển
				</a>

				<div class="nav-section">Quản lý</div>
				<a href="/ProductAdmin" class="@(Context.Request.Path.StartsWithSegments("/ProductAdmin") ? "active" : "")">
					<i class="fas fa-box-open"></i>
					Sản phẩm
				</a>
				<a href="/CategoryAdmin" class="@(Context.Request.Path.StartsWithSegments("/CategoryAdmin") ? "active" : "")">
					<i class="fas fa-layer-group"></i>
					Danh mục
				</a>
				<a href="/OrderAdmin" class="@(Context.Request.Path.StartsWithSegments("/OrderAdmin") ? "active" : "")">
					<i class="fas fa-file-invoice-dollar"></i>
					Đơn hàng
				</a>
				<a href="/RevenueAdmin" class="@(Context.Request.Path.StartsWithSegments("/RevenueAdmin") ? "active" : "")">
					<i class="fas fa-coins"></i>
					Doanh thu
				</a>

				<a href="/AdvertisingAdmin" class="@(Context.Request.Path.StartsWithSegments("/AdvertisingAdmin") ? "active" : "")">
					<i class="fas fa-bullhorn"></i>
					Quảng cáo
				</a>
				<a href="/VoucherAdmin" class="@(Context.Request.Path.StartsWithSegments("/VoucherAdmin") ? "active" : "")">
					<i class="fas fa-ticket-alt"></i>
					Mã ưu đãi
				</a>

				<div class="nav-section">Khác</div>
				<a href="/" target="_blank">
					<i class="fas fa-home"></i>
					Xem trang khách
				</a>
				<a href="/Auth/Logout">
					<i class="fas fa-sign-out-alt"></i>
					Đăng xuất
				</a>
			</nav>
		</aside>

		<div class="admin-main">
			<header class="admin-topbar">
				<div>
					<div class="admin-topbar-title">@ViewData["Title"] ?? "Bảng điều khiển"</div>
					<div class="admin-topbar-sub">Quản trị hệ thống Nguồn Việt</div>
				</div>
				<div class="admin-topbar-actions">
					<a href="/ProductAdmin/Create" class="btn btn-sm btn-success rounded-pill px-3">
						<i class="fas fa-plus me-1"></i> Thêm sản phẩm
					</a>
					<a href="/" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
						<i class="fas fa-external-link-alt me-1"></i> Xem website
					</a>
				</div>
			</header>

			<main class="admin-content">
				@RenderBody()
			</main>
		</div>
	</div>

	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
	<script src="~/js/bootstrap.bundle.min.js"></script>

	@RenderSection("Scripts", required: false)
</body>
</html>

