@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title ?? "Thông báo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="alert alert-warning border-0 shadow-sm p-4">
                <div class="d-flex gap-3 align-items-start">
                    <div class="fs-3 text-warning">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <div>
                        <h4 class="alert-heading mb-2">@(Model.Title ?? "Không thể truy cập")</h4>
                        <p class="mb-3">@(Model.Message ?? "Yêu cầu chưa hợp lệ. Vui lòng kiểm tra lại thông tin và thử lại.")</p>
                        @if (Model.StatusCode.HasValue)
                        {
                            <div class="small text-muted mb-3">Mã thông báo: @Model.StatusCode</div>
                        }
                        <div class="d-flex gap-2 flex-wrap">
                            <a href="/" class="btn btn-primary rounded-pill px-4">Về trang chủ</a>
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="history.back()">Quay lại</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
