@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="utf-8">
	<title>Nguồn Việt</title>
	<meta content="width=device-width, initial-scale=1.0" name="viewport">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">

	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

	<link href="~/css/bootstrap.min.css" rel="stylesheet">
	<link href="~/css/style.css" rel="stylesheet">
	<link href="~/css/chat.css" rel="stylesheet">

	<link href="~/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
	<link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

</head>

<body class="@(Context.Request.Path.StartsWithSegments("/Seller") ? "seller-page" : "")">

	<!-- Spinner -->
	<div id="spinner"
		 class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">

		<div class="spinner-grow text-primary" role="status"></div>

	</div>


	<!-- Topbar -->
	<div class="container-fluid fixed-top">

		<div class="container topbar bg-primary d-none d-lg-block">

			<div class="nv-topbar-row">

				<div class="top-info ps-2">
					<small class="text-white">
						<i class="fas fa-map-marker-alt me-2" style="opacity:0.9"></i>
						Đại học FPT, Thạch Thất, Hà Nội
					</small>
					<small class="text-white">
						<i class="fas fa-phone-alt me-2" style="opacity:0.9"></i>
						0378181882
					</small>
					<small class="text-white">
						<i class="fas fa-users me-2" style="opacity:0.9"></i>
						Nhóm Nguồn Việt
					</small>
				</div>
				<div class="top-link pe-2">
					<a href="/Contact" class="text-white text-decoration-none"><small>Liên hệ</small></a>
					<span class="text-white opacity-75">/</span>
					<a href="/Product" class="text-white text-decoration-none"><small>Khám phá đặc sản</small></a>
				</div>

			</div>

		</div>


		<!-- Navbar -->
		<div class="container px-0 nv-header-container">

			<nav class="navbar navbar-light bg-white navbar-expand-xl nv-main-navbar">

				<a href="/" class="navbar-brand nv-brand logo-area">
					<span class="nv-brand-mark"><i class="fas fa-leaf"></i></span>
					<span>
						<span class="nv-brand-name">Nguồn Việt</span>
						<span class="nv-brand-tagline">Đặc sản vùng miền</span>
					</span>
				</a>

				<button class="navbar-toggler py-2 px-3"
						type="button"
						data-bs-toggle="collapse"
						data-bs-target="#navbarCollapse">

					<span class="fa fa-bars text-primary"></span>

				</button>

				<div class="collapse navbar-collapse bg-white nv-navbar-collapse"
					 id="navbarCollapse">

					<div class="navbar-nav mx-auto nv-main-menu nav-menu">
						<a href="/" class="nav-item nav-link">Trang chủ</a>
						<a href="/Product" class="nav-item nav-link">Đặc sản</a>
						<a href="/Seller" class="nav-item nav-link" data-seller-upgrade-prompt="@((Context.Session.GetInt32("UserId").HasValue && Context.Session.GetString("RoleName") != "Seller" && Context.Session.GetString("RoleName") != "Admin").ToString().ToLowerInvariant())">Kênh người bán</a>
						<a href="/Game" class="nav-item nav-link">Trò chơi</a>
						<a href="/Cart" class="nav-item nav-link">Giỏ hàng</a>
						<a href="/Checkout" class="nav-item nav-link">Thanh toán</a>
						<a href="/Contact" class="nav-item nav-link">Liên hệ</a>
						@if (Context.Session.GetInt32("UserId") != null)
						{
							<a href="/Journey" class="nav-item nav-link">Hành trình</a>
							<a href="/Account/MyOrders" class="nav-item nav-link">Hóa đơn</a>
							<a href="/Account/Wallet" class="nav-item nav-link">Ví</a>
							<a href="/Account/Edit" class="nav-item nav-link">Tài khoản</a>
						}
					</div>

					<div class="nav-actions nv-nav-actions header-actions">

						<button class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white me-4"
								data-bs-toggle="modal"
								data-bs-target="#searchModal"
								aria-label="Tìm kiếm">
							<i class="fas fa-search text-primary"></i>
						</button>

						@inject EXE.Models.ApplicationDbContext Db
						@{
							var cartId = Context.Session.GetInt32("CartId");
							var userId = Context.Session.GetInt32("UserId");
							var roleName = Context.Session.GetString("RoleName") ?? string.Empty;
							var fullName = Context.Session.GetString("FullName") ?? string.Empty;
							var isBackoffice = string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase)
								|| string.Equals(roleName, "Staff", StringComparison.OrdinalIgnoreCase)
								|| string.Equals(roleName, "Seller", StringComparison.OrdinalIgnoreCase);

							// Backward compatible: if older sessions only have UserId, infer role and name from DB.
							if (userId.HasValue && (string.IsNullOrWhiteSpace(roleName) || string.IsNullOrWhiteSpace(fullName)))
							{
								var u = Db.Users
									.Include(u => u.Role)
									.FirstOrDefault(u => u.UserId == userId.Value);
								if (string.IsNullOrWhiteSpace(roleName)) roleName = u?.Role?.RoleName ?? string.Empty;
								if (string.IsNullOrWhiteSpace(fullName)) fullName = u?.FullName ?? u?.Email ?? "User";
								isBackoffice = roleName == "Admin" || roleName == "Staff" || roleName == "Seller";
							}

							var cartCount = 0;
							if (cartId.HasValue)
							{
								cartCount = Db.CartItems.Where(x => x.CartId == cartId.Value).Sum(x => (int?)(x.Quantity ?? 0)) ?? 0;
							}
							else if (userId.HasValue)
							{
								var uCartId = Db.Carts.Where(x => x.UserId == userId.Value).OrderByDescending(x => x.CreatedDate).Select(x => (int?)x.CartId).FirstOrDefault();
								if (uCartId.HasValue)
								{
									cartCount = Db.CartItems.Where(x => x.CartId == uCartId.Value).Sum(x => (int?)(x.Quantity ?? 0)) ?? 0;
								}
							}
						}

						<a href="/Cart" class="position-relative my-auto nv-cart-link" aria-label="Giỏ hàng">
							<i class="fa fa-shopping-bag fa-2x"></i>
							@if (cartCount > 0)
							{
								<span class="position-absolute bg-secondary rounded-circle d-flex align-items-center justify-content-center text-dark px-1"
									  style="top:-5px; left:15px; height:20px; min-width:20px;">
									@cartCount
								</span>
							}
						</a>

						@if (isBackoffice)
						{
							<div class="dropdown my-auto">
								<a class="btn user-btn dropdown-toggle"
								   href="#"
								   role="button"
								   data-bs-toggle="dropdown"
								   aria-expanded="false">
									<i class="fas fa-user-shield me-2"></i><span class="nv-user-name">Xin chào, @(fullName)</span>
								</a>
								<ul class="dropdown-menu dropdown-menu-end">
									@if (roleName == "Admin")
									{
										<li><a class="dropdown-item" href="/Admin">Bảng điều khiển admin</a></li>
										<li><a class="dropdown-item" href="/ProductAdmin">Quản lý sản phẩm</a></li>
										<li><a class="dropdown-item" href="/CategoryAdmin">Quản lý danh mục</a></li>
										<li><a class="dropdown-item" href="/OrderAdmin">Quản lý đơn hàng</a></li>
									}
									else if (roleName == "Staff")
									{
										<li><a class="dropdown-item" href="/Staff">Bảng điều khiển staff</a></li>
										<li><a class="dropdown-item" href="/StaffOrder">Đơn hàng</a></li>
									}
									else if (roleName == "Seller")
									{
										<li><a class="dropdown-item" href="/Seller">Kênh người bán</a></li>
										<li><a class="dropdown-item" href="/Seller/Create">Đăng sản phẩm</a></li>
										<li><a class="dropdown-item" href="/Seller/Orders">Đơn hàng của shop</a></li>
									}
									<li><hr class="dropdown-divider"></li>
									<li><a class="dropdown-item" href="/Auth/Logout">Đăng xuất</a></li>
								</ul>
							</div>
							<a href="/Auth/Logout" class="btn btn-link text-danger p-0 ms-2" title="Đăng xuất" aria-label="Đăng xuất">
								<i class="fas fa-sign-out-alt"></i>
							</a>
						}
						else if (Context.Session.GetInt32("UserId") != null)
						{
							<div class="dropdown d-flex align-items-center gap-2 my-auto">
								@await Component.InvokeAsync("JourneyLevel")
								<a class="btn user-btn dropdown-toggle"
								   href="#"
								   role="button"
								   data-bs-toggle="dropdown"
								   aria-expanded="false">
									<i class="fas fa-user me-2"></i><span class="nv-user-name">Xin chào, @(fullName)</span>
								</a>
								<ul class="dropdown-menu dropdown-menu-end">
									<li><a class="dropdown-item" href="/Journey"><i class="fas fa-route me-2"></i>Hành trình đặc sản</a></li>
									<li><a class="dropdown-item" href="/Account/MyOrders"><i class="fas fa-file-invoice-dollar me-2"></i>Hóa đơn của tôi</a></li>
									<li><a class="dropdown-item" href="/Account/Wallet"><i class="fas fa-wallet me-2"></i>Ví điện tử</a></li>
									<li><a class="dropdown-item" href="/Account/Edit"><i class="fas fa-user-edit me-2"></i>Tài khoản</a></li>
									<li><hr class="dropdown-divider"></li>
									<li><a class="dropdown-item" href="/Auth/Logout">Đăng xuất</a></li>
								</ul>
							</div>
							<a href="/Auth/Logout" class="btn btn-link text-danger p-0 ms-2" title="Đăng xuất" aria-label="Đăng xuất">
								<i class="fas fa-sign-out-alt"></i>
							</a>
						}
						else
						{
							<a href="/Auth/Login" class="btn user-btn my-auto" aria-label="Đăng nhập">
								<i class="fas fa-user me-2"></i>Đăng nhập
							</a>
						}

					</div>

				</div>

			</nav>

		</div>

	</div>

	<!-- Modal Search Start -->
	<div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-fullscreen">
			<div class="modal-content rounded-0">
				<div class="modal-header">
					<h5 class="modal-title" id="searchModalLabel">Tìm kiếm</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body d-flex align-items-center">
					<form class="input-group w-75 mx-auto d-flex" method="get" action="/Product">
						<input type="search" class="form-control p-3" name="q" placeholder="Nhập tên đặc sản, địa phương..." aria-describedby="search-icon-1">
						<button id="search-icon-1" class="input-group-text p-3" type="submit" aria-label="Tìm">
							<i class="fa fa-search"></i>
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
	<!-- Modal Search End -->


	<!-- Page Content -->
	<div class="container-fluid mt-5 pt-5 px-0">

		@RenderBody()

	</div>


	<!-- Footer -->
	<footer class="container-fluid footer nv-site-footer mt-5">
		<div class="container py-5">
			<div class="row g-4 align-items-start">
				<div class="col-lg-5">
					<a href="/" class="nv-footer-brand">
						<span class="nv-footer-mark"><i class="fas fa-leaf"></i></span>
						<span>
							<span class="nv-footer-name">Nguồn Việt</span>
							<span class="nv-footer-tagline">Tinh hoa đặc sản vùng miền Việt Nam</span>
						</span>
					</a>
					<p class="nv-footer-desc mt-3 mb-0">
						Nguồn Việt kết nối người mua với các sản phẩm đặc sản địa phương, ưu tiên nguồn gốc rõ ràng,
						thông tin minh bạch và trải nghiệm mua sắm thuận tiện.
					</p>
				</div>

				<div class="col-lg-3 col-md-6">
					<h4 class="nv-footer-heading">Liên kết nhanh</h4>
					<div class="nv-footer-links">
						<a href="/">Trang chủ</a>
						<a href="/Product">Đặc sản</a>
						<a href="/Seller">Kênh người bán</a>
						<a href="/Cart">Giỏ hàng</a>
						<a href="/Contact">Liên hệ</a>
					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<h4 class="nv-footer-heading">Thông tin liên hệ</h4>
					<div class="nv-footer-contact">
						<div>
							<i class="fas fa-phone-alt"></i>
							<span>0378181882</span>
						</div>
						<div>
							<i class="fas fa-map-marker-alt"></i>
							<span>Đại học FPT, Thạch Thất, Hà Nội</span>
						</div>
						<div>
							<i class="fas fa-users"></i>
							<span>Nhóm Nguồn Việt</span>
						</div>
						<div>
							<i class="fab fa-facebook-f"></i>
							<span>Facebook: Nguồn Việt</span>
						</div>
						<div>
							<i class="fas fa-clock"></i>
							<span>Hỗ trợ: 08:00 - 22:00 hằng ngày</span>
						</div>
						<div>
							<i class="fas fa-shield-alt"></i>
							<span>Ưu tiên đặc sản rõ nguồn gốc, thông tin minh bạch</span>
						</div>
					</div>
					<div class="nv-footer-social mt-3">
						<a href="#" aria-label="Facebook Nguồn Việt" title="Facebook: Nguồn Việt"><i class="fab fa-facebook-f"></i></a>
						<a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
					</div>
				</div>
			</div>
		</div>
	</footer>

	<!-- Copyright Start -->
	<div class="container-fluid copyright bg-dark py-4">
		<div class="container">
			<div class="row">
				<div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
					<span class="text-light">
						<a href="#"><i class="fas fa-copyright text-light me-2"></i>Nguồn Việt</a>, Bảo lưu mọi quyền.
					</span>
				</div>
				<div class="col-md-6 my-auto text-center text-md-end text-white">
					Liên hệ: Nhóm Nguồn Việt - 0378181882
				</div>
			</div>
		</div>
	</div>
	<!-- Copyright End -->

	<!-- Back to Top -->
	<a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>


	<!-- JS -->
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
	<script src="~/lib/easing/easing.min.js"></script>
	<script src="~/lib/waypoints/waypoints.min.js"></script>
	<script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
	<script src="~/lib/lightbox/js/lightbox.min.js"></script>
	<script src="~/js/main.js"></script>
	<script>
		document.querySelectorAll('[data-seller-upgrade-prompt="true"]').forEach(function (link) {
			link.addEventListener('click', function (event) {
				var agree = confirm('Bạn chưa đăng ký tài khoản người bán. Bạn có muốn nâng cấp để mở tài khoản người bán không?');
				if (!agree) {
					event.preventDefault();
					return;
				}

				event.preventDefault();
				window.location.href = '/Auth/Login#seller-register';
			});
		});
	</script>
	<!-- Chatbox -->
	<div id="chatbox" class="chatbox collapsed">
		<div id="chatHeader" class="chat-header">
			<div><i class="fas fa-comments me-2"></i>Hỗ trợ nhanh</div>
			<div><small>Click để mở</small></div>
		</div>
		<div class="chat-body">
			<div id="chatMessages" class="chat-messages"></div>
			<div class="chat-input">
				<input id="chatInput" type="text" class="form-control" placeholder="Nhập câu hỏi..." />
				<button id="chatSend" class="btn btn-primary" type="button">Gửi</button>
			</div>
		</div>
	</div>

	<script src="~/js/chat.js"></script>

	@RenderSection("Scripts", required: false)

</body>

</html>
