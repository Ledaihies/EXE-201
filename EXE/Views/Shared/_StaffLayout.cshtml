@{
	var title = ViewData["Title"] as string ?? "Nhân viên - Nguồn Việt";
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<title>@title</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

	<link href="~/css/bootstrap.min.css" rel="stylesheet" />
	<link href="~/css/style.css" rel="stylesheet" />

	<style>
		body {
			background-color: #f4f4f7;
			font-family: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		}

		.staff-shell {
			min-height: 100vh;
			display: grid;
			grid-template-rows: 56px 1fr;
		}

		.staff-topbar {
			background: #16a34a;
			color: #ecfdf3;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0 1.5rem;
		}

		.staff-topbar h3 {
			font-size: 1.1rem;
			font-weight: 600;
			margin: 0;
		}

		.staff-main {
			display: grid;
			grid-template-columns: 220px 1fr;
		}

		.staff-sidebar {
			background: #ffffff;
			border-right: 1px solid rgba(15, 23, 42, 0.06);
			padding: 1rem 0.5rem 1.5rem;
		}

		.staff-sidebar .nav-title {
			padding: 0.5rem 1rem 0.25rem;
			font-size: 0.75rem;
			text-transform: uppercase;
			color: #94a3b8;
			font-weight: 600;
		}

		.staff-sidebar a {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			padding: 0.5rem 1rem;
			margin: 0.1rem 0.5rem;
			border-radius: 999px;
			color: #0f172a;
			text-decoration: none;
			font-size: 0.9rem;
		}

		.staff-sidebar a i {
			width: 18px;
			text-align: center;
			color: #64748b;
		}

		.staff-sidebar a.active,
		.staff-sidebar a:hover {
			background: #ecfdf3;
			color: #166534;
		}

		.staff-sidebar a.active i,
		.staff-sidebar a:hover i {
			color: #16a34a;
		}

		.staff-content {
			padding: 1.5rem 1.75rem 2.5rem;
		}
	</style>
</head>
<body>
	<div class="staff-shell">
		<header class="staff-topbar">
			<div>
				<h3>Khu làm việc nhân viên</h3>
				<div class="small">Quản lý đơn hàng Nguồn Việt</div>
			</div>
			<div>
				<a href="/" class="btn btn-sm btn-light rounded-pill px-3 me-2">
					<i class="fas fa-home me-1"></i> Trang khách
				</a>
				<a href="/Auth/Logout" class="btn btn-sm btn-outline-light rounded-pill px-3">
					<i class="fas fa-sign-out-alt me-1"></i> Đăng xuất
				</a>
			</div>
		</header>
		<div class="staff-main">
			<aside class="staff-sidebar">
				<div class="nav-title">Tổng quan</div>
				<a href="/Staff" class="@(Context.Request.Path.StartsWithSegments("/Staff") ? "active" : "")">
					<i class="fas fa-chart-line"></i> Bảng điều khiển
				</a>
				<div class="nav-title">Nghiệp vụ</div>
				<a href="/StaffOrder" class="@(Context.Request.Path.StartsWithSegments("/StaffOrder") ? "active" : "")">
					<i class="fas fa-file-invoice-dollar"></i> Đơn hàng
				</a>
			</aside>
			<main class="staff-content">
				@RenderBody()
			</main>
		</div>
	</div>

	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
	<script src="~/js/bootstrap.bundle.min.js"></script>

	@RenderSection("Scripts", required: false)
</body>
</html>

