@{
	Layout = "~/Views/Shared/_StaffLayout.cshtml";
	ViewData["Title"] = "Bảng điều khiển nhân viên";
	int totalOrders = ViewBag.TotalOrders ?? 0;
	int pendingOrders = ViewBag.PendingOrders ?? 0;
	int todayOrders = ViewBag.TodayOrders ?? 0;
}

<div class="mb-4">
	<h2 class="mb-1">Bảng điều khiển nhân viên</h2>
	<p class="text-muted mb-0 small">Theo dõi nhanh đơn hàng và trạng thái xử lý.</p>
</div>

<div class="row g-3 mb-4">
	<div class="col-md-4">
		<div class="card border-0 shadow-sm h-100">
			<div class="card-body">
				<div class="text-muted small mb-1">Tổng đơn hàng</div>
				<div class="h3 mb-0">@totalOrders</div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card border-0 shadow-sm h-100">
			<div class="card-body">
				<div class="text-muted small mb-1">Đơn chờ xử lý</div>
				<div class="h3 mb-0">@pendingOrders</div>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card border-0 shadow-sm h-100">
			<div class="card-body">
				<div class="text-muted small mb-1">Đơn hôm nay</div>
				<div class="h3 mb-0">@todayOrders</div>
			</div>
		</div>
	</div>
</div>

<div class="card border-0 shadow-sm">
	<div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
		<div class="small text-muted">
			Bạn có thể vào mục <strong>Đơn hàng</strong> để xem danh sách chi tiết và cập nhật trạng thái.
		</div>
		<a href="/StaffOrder" class="btn btn-sm btn-primary rounded-pill px-3">
			<i class="fas fa-file-invoice-dollar me-1"></i> Xem đơn hàng
		</a>
	</div>
</div>

