@model IEnumerable<EXE.Models.Product>

@{
	var location = (string?)ViewBag.Location;
	var locationLabel = string.IsNullOrWhiteSpace(location) ? "Gợi ý nổi bật" : location;
}

<div class="nv-region-card card border-0 shadow-sm h-100">
	<div class="card-body p-4">
		<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
			<div>
				<div class="d-flex align-items-center gap-2">
					<div class="nv-icon-badge bg-primary text-white">
						<i class="fas fa-map-marked-alt"></i>
					</div>
					<h3 class="mb-0">Đặc sản theo khu vực</h3>
				</div>
				<div class="text-muted small mt-1">
					Đang hiển thị: <span class="fw-semibold">@locationLabel</span>
				</div>
			</div>
			<div class="d-flex align-items-center gap-2">
				<span class="badge rounded-pill text-bg-light border">
					<i class="fas fa-location-dot me-1 text-primary"></i>@Model.Count() sản phẩm
				</span>
			</div>
		</div>

	@if (!Model.Any())
	{
		<div class="nv-empty-state border rounded-4 p-4 bg-light">
			<div class="d-flex align-items-start gap-3">
				<div class="nv-icon-badge bg-secondary text-white">
					<i class="fas fa-magnifying-glass"></i>
				</div>
				<div>
					<div class="fw-semibold mb-1">Chưa có gợi ý phù hợp</div>
					<div class="text-muted small">
						Bạn có thể bấm “Định vị” hoặc click trên bản đồ để chọn khu vực khác. Nếu chưa cho phép vị trí, hệ thống sẽ hiển thị mặc định.
					</div>
				</div>
			</div>
		</div>
	}
	else
	{
		<div class="row g-3">
			@foreach (var item in Model)
			{
				var image = item.ProductImages.FirstOrDefault()?.ImageUrl ?? "no-image.svg";
				var regionName = item.Region?.RegionName ?? "Đặc sản";

				<div class="col-md-6 col-xl-6">
					<div class="nv-product-mini card border-0 shadow-sm">
						<div class="row g-0">
							<div class="col-4">
								<div class="nv-thumb h-100">
									<img src="~/img/@image" class="img-fluid" alt="" onerror="this.onerror=null;this.src='/img/no-image.svg';">
									<div class="nv-region-pill">@regionName</div>
								</div>
							</div>
							<div class="col-8">
								<div class="card-body p-3 d-flex flex-column">
									<div class="fw-semibold text-truncate">@item.ProductName</div>
									<div class="text-muted small mt-1 nv-2line">
										@item.Description
									</div>
									<div class="mt-auto pt-2 d-flex align-items-center justify-content-between gap-2">
										<div class="fw-bold text-dark">
											@String.Format("{0:N0}", item.Price ?? 0) đ
										</div>
										<div class="d-flex align-items-center gap-2">
											<a href="/Product/Details/@item.ProductId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
												Xem
											</a>
											<a href="/Cart/Add/@item.ProductId"
											   class="btn btn-sm btn-primary rounded-pill px-2"
											   aria-label="Thêm vào giỏ">
												<i class="fa fa-shopping-bag"></i>
											</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>
</div>

