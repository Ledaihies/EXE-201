<section class="nv-bestseller-section py-5">
	<div class="container">
		<div class="text-center mb-4">
			<span class="text-secondary text-uppercase small fw-semibold" style="letter-spacing:.12em;">Được yêu thích</span>
			<h2 class="h3 fw-bold text-dark mt-2 mb-0">Bán chạy</h2>
		</div>
		<div class="row g-4 justify-content-center">
			@foreach (var item in (Model.AdvertisedProducts ?? Enumerable.Empty<EXE.Models.Product>()).Take(4))
			{
				var image = item.ProductImages.FirstOrDefault()?.ImageUrl ?? "no-image.svg";
				<div class="col-6 col-md-4 col-lg-3">
					<div class="nv-product-card nv-product-card--grid nv-product-card--bestseller card h-100 border-0 shadow-sm">
						<div class="nv-product-card__img-wrap position-relative">
							<a href="/Product/Details/@item.ProductId">
								<img src="~/img/@image" class="nv-product-card__img" alt="@item.ProductName" onerror="this.onerror=null;this.src='/img/no-image.svg';">
							</a>
						</div>
						<div class="card-body d-flex flex-column p-3">
							<a href="/Product/Details/@item.ProductId" class="text-decoration-none text-dark">
								<h5 class="card-title nv-product-card__title mb-2">@item.ProductName</h5>
							</a>
							<div class="mt-auto pt-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
								<span class="text-primary fw-bold">@String.Format("{0:N0}", item.Price) đ</span>
								<div class="d-flex gap-2">
									<a href="/Product/Details/@item.ProductId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Xem</a>
									<a href="/Cart/Add/@item.ProductId" class="btn btn-sm btn-primary rounded-pill px-3" title="Thêm giỏ"><i class="fa fa-cart-plus"></i></a>
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
		<div class="text-center mt-4">
			<a href="/Product" class="btn btn-outline-primary rounded-pill px-4">Xem tất cả đặc sản</a>
		</div>
	</div>
</section>

