@model EXE.ViewModels.HomeIndexViewModel

@{
	var todayKey = DateTime.UtcNow.ToString("yyyy-MM-dd");
	var isLoggedIn = Context.Session.GetInt32("UserId") != null;
}

<style>
	.nv-entry-banner {
		position: fixed;
		inset: 0;
		z-index: 2000;
		display: none;
	}

	.nv-entry-banner.is-open {
		display: block;
	}

	.nv-entry-banner__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(2, 6, 23, .62);
		backdrop-filter: blur(2px);
	}

	.nv-entry-banner__dialog {
		position: relative;
		z-index: 1;
		width: min(820px, calc(100vw - 28px));
		max-width: 820px;
		margin: 8vh auto;
		padding: 0;
	}

	.nv-entry-banner__card {
		background: #fff;
		border-radius: 18px;
		box-shadow: 0 30px 90px rgba(0, 0, 0, .35);
		overflow: hidden;
		max-height: 80vh;
		display: flex;
		flex-direction: column;
	}

	.nv-entry-banner__header {
		flex: 0 0 auto;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		padding: 14px 16px 10px 16px;
		border-bottom: 1px solid rgba(148, 163, 184, .28);
		background: #fff;
	}

	.nv-entry-banner__title {
		margin: 0;
		font-weight: 800;
		line-height: 1.2;
	}

	.nv-entry-banner__subtitle {
		margin: 6px 0 0 0;
		color: #64748b;
		font-size: .9rem;
	}

	.nv-entry-banner__close {
		border: 0;
		background: transparent;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #0f172a;
	}

	.nv-entry-banner__close:hover {
		background: rgba(15, 23, 42, .06);
	}

	.nv-entry-banner__body {
		flex: 1 1 auto;
		min-height: 0;
		padding: 12px 16px 14px 16px;
		overflow-x: hidden;
		overflow-y: auto;
	}

	.nv-entry-banner__section-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin: 8px 0 10px 0;
	}

	.nv-entry-banner__products {
		max-height: min(46vh, 390px);
		overflow-x: hidden;
		overflow-y: auto;
		padding-right: 4px;
	}

	.nv-entry-banner__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 10px;
	}

	@@media (min-width: 576px) {
		.nv-entry-banner__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@@media (min-width: 992px) {
		.nv-entry-banner__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.nv-entry-banner__item {
		border: 1px solid rgba(148, 163, 184, .45);
		border-radius: 14px;
		overflow: hidden;
		background: #fff;
	}

	.nv-entry-banner__item a {
		color: inherit;
		text-decoration: none;
	}

	.nv-entry-banner__thumb {
		height: 96px;
		background: #f1f5f9;
	}

	.nv-entry-banner__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.nv-entry-banner__item-body {
		padding: 8px 10px 10px 10px;
	}

	.nv-entry-banner__name {
		font-weight: 700;
		font-size: .9rem;
		margin: 0 0 6px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 2.4em;
	}

	.nv-entry-banner__price {
		margin: 0;
		color: #0d6efd;
		font-weight: 800;
		font-size: .92rem;
	}

	.nv-entry-banner__product-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-top: 8px;
	}

	.nv-entry-banner__add-cart {
		flex: 0 0 auto;
		min-height: 32px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		white-space: nowrap;
	}

	.nv-entry-banner__pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		margin: 12px 0 6px 0;
	}

	.nv-entry-banner__page-status {
		min-width: 82px;
		text-align: center;
		font-size: .9rem;
		font-weight: 700;
		color: #334155;
	}

	.nv-entry-banner__voucher {
		border: 1px dashed rgba(234, 88, 12, .55);
		background: rgba(255, 237, 213, .55);
	}

	.nv-entry-banner__voucher .nv-entry-banner__item-body {
		padding: 12px;
	}

	.nv-entry-banner__voucher-code {
		font-weight: 900;
		letter-spacing: .08em;
	}

	.nv-entry-banner__footer {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 12px;
		padding: 10px 16px 14px 16px;
		border-top: 1px solid rgba(148, 163, 184, .35);
		background: #fff;
	}

	.nv-entry-banner__hint {
		color: #64748b;
		font-size: .9rem;
		margin: 0;
	}

	@@media (max-width: 575.98px) {
		.nv-entry-banner__dialog {
			width: min(380px, calc(100vw - 20px));
			margin: 4vh auto;
		}

		.nv-entry-banner__card {
			max-height: 80vh;
			border-radius: 14px;
		}

		.nv-entry-banner__header {
			padding: 12px 12px 8px 12px;
		}

		.nv-entry-banner__title {
			font-size: 1.05rem;
		}

		.nv-entry-banner__subtitle {
			font-size: .82rem;
		}

		.nv-entry-banner__body {
			padding: 10px 12px 12px 12px;
		}

		.nv-entry-banner__products {
			max-height: 48vh;
		}

		.nv-entry-banner__thumb {
			height: 104px;
		}

		.nv-entry-banner__product-actions {
			align-items: stretch;
			flex-direction: column;
		}

		.nv-entry-banner__add-cart {
			width: 100%;
		}

		.nv-entry-banner__footer {
			padding: 10px 12px 12px 12px;
		}
	}
</style>

<!-- Entry banner (sản phẩm nổi bật hôm nay + voucher) -->
<div class="nv-entry-banner" id="nvEntryBanner" aria-hidden="true">
	<div class="nv-entry-banner__backdrop" data-entry-banner-close="backdrop"></div>
	<div class="nv-entry-banner__dialog" role="dialog" aria-modal="true" aria-label="Banner hôm nay">
		<div class="nv-entry-banner__card">
			<div class="nv-entry-banner__header">
				<div>
					<h3 class="nv-entry-banner__title">Sản phẩm đang được bán chạy</h3>
					<p class="nv-entry-banner__subtitle">Những sản phẩm nổi bật được nhiều khách hàng quan tâm. Đóng để xem trang chủ.</p>
				</div>
				<button type="button" class="nv-entry-banner__close" aria-label="Đóng" id="nvEntryBannerCloseBtn">
					<i class="fa fa-times"></i>
				</button>
			</div>

			<div class="nv-entry-banner__body">
				<div class="nv-entry-banner__section-label">
					<strong>Sản phẩm bán chạy hôm nay</strong>
					<a class="btn btn-sm btn-outline-primary rounded-pill px-3" href="/Product?sort=newest">Xem thêm</a>
				</div>

				<div class="nv-entry-banner__products">
					<div class="nv-entry-banner__grid" id="nvEntryBannerProductGrid">
					@foreach (var p in (Model.AdvertisedProducts ?? Enumerable.Empty<EXE.Models.Product>()).Take(10))
					{
						var img = p.ProductImages.FirstOrDefault()?.ImageUrl ?? "no-image.svg";
						var isOutOfStock = p.Stock.HasValue && p.Stock.Value <= 0;
						<div class="nv-entry-banner__item nv-entry-banner__product-item">
							<a href="/Product/Details/@p.ProductId">
								<div class="nv-entry-banner__thumb">
									<img src="~/img/@img" alt="@p.ProductName" onerror="this.onerror=null;this.src='/img/no-image.svg';">
								</div>
								<div class="nv-entry-banner__item-body">
									<p class="nv-entry-banner__name">@p.ProductName</p>
								</div>
							</a>
							<div class="nv-entry-banner__item-body pt-0">
								<div class="nv-entry-banner__product-actions">
									<p class="nv-entry-banner__price">@String.Format("{0:N0}", p.Price ?? 0) đ</p>
									@if (isOutOfStock)
									{
										<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 nv-entry-banner__add-cart" disabled>
											Hết hàng
										</button>
									}
									else
									{
										<a href="/Cart/Add/@p.ProductId" class="btn btn-sm btn-primary rounded-pill px-3 nv-entry-banner__add-cart" title="Thêm vào giỏ">
											<i class="fa fa-cart-plus"></i>
											<span>Thêm giỏ</span>
										</a>
									}
								</div>
							</div>
						</div>
					}
					</div>
				</div>

				<div class="nv-entry-banner__pagination" id="nvEntryBannerPagination">
					<button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" id="nvEntryBannerPrevBtn">Tr&#432;&#7899;c</button>
					<span class="nv-entry-banner__page-status" id="nvEntryBannerPageStatus">1 / 1</span>
					<button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" id="nvEntryBannerNextBtn">Sau</button>
				</div>

				@if (Model.ActiveVouchers != null && Model.ActiveVouchers.Any())
				{
					<div class="nv-entry-banner__section-label">
						<strong>Voucher</strong>
						<a class="btn btn-sm btn-outline-warning rounded-pill px-3" href="#voucherSection" onclick="document.getElementById('voucherSection')?.scrollIntoView({behavior:'smooth'}); return false;">Xem ở trang</a>
					</div>
					<div class="nv-entry-banner__grid">
						@foreach (var v in Model.ActiveVouchers.Take(3))
						{
							var isPercent = (v.DiscountPercent ?? 0) > 0;
							var discountText = v.IsFreeShipping ? "Free ship" : isPercent
								? $"{v.DiscountPercent}%"
								: (v.DiscountFixed.HasValue ? String.Format("{0:N0} đ", v.DiscountFixed.Value) : "Ưu đãi");
							var minOrderText = v.MinOrderAmount.HasValue ? $"ĐH từ {v.MinOrderAmount.Value.ToString("N0")} đ" : "Không tối thiểu";
							<div class="nv-entry-banner__item nv-entry-banner__voucher">
								<div class="nv-entry-banner__item-body">
									<div class="d-flex align-items-center justify-content-between gap-2 mb-2">
										<span class="badge bg-dark text-warning">@discountText OFF</span>
										<button type="button"
												class="btn btn-sm btn-outline-primary rounded-pill px-3"
												onclick="handleCopyVoucher('@v.Code', @(isLoggedIn ? "true" : "false"))">
											Sao chép
										</button>
									</div>
									<div class="nv-entry-banner__voucher-code">@v.Code</div>
									<div class="small text-muted mt-1">@minOrderText</div>
									@if (!string.IsNullOrWhiteSpace(v.Description))
									{
										<div class="small mt-2">@v.Description</div>
									}
								</div>
							</div>
						}
					</div>
				}
			</div>

			<div class="nv-entry-banner__footer">
				<button type="button" class="btn btn-primary rounded-pill px-4" id="nvEntryBannerGoHomeBtn">
					Xem trang chủ
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Hôm nay Nguồn Việt có gì mới - thanh sản phẩm 1 hàng, trượt ngang bằng mũi tên -->
<div class="container-fluid py-4 border-bottom nv-featured-strip">
	<div class="container-fluid px-3 px-md-4 position-relative">
		<h5 class="text-primary mb-3 text-center">Sản phẩm nổi bật của chúng tôi</h5>

		<button type="button"
				class="nv-featured-strip-arrow nv-featured-strip-arrow--prev"
				aria-label="Xem sản phẩm trước">
			<i class="fa fa-angle-left"></i>
		</button>

		<button type="button"
				class="nv-featured-strip-arrow nv-featured-strip-arrow--next"
				aria-label="Xem sản phẩm tiếp theo">
			<i class="fa fa-angle-right"></i>
		</button>

		<div class="nv-featured-strip-viewport" id="featuredProductsViewport">
			<div class="nv-featured-strip-track" id="featuredProductsTrack">
				@foreach (var item in (Model.AdvertisedProducts ?? Enumerable.Empty<EXE.Models.Product>()).Take(10))
				{
					var image = item.ProductImages.FirstOrDefault()?.ImageUrl ?? "no-image.svg";
					<div class="nv-featured-strip-item">
						<div class="card border-0 h-100 shadow-sm rounded-3 overflow-hidden nv-featured-strip-card">
							<a href="/Product/Details/@item.ProductId" class="text-decoration-none text-dark">
								<div class="position-relative nv-featured-strip-img">
									<img src="~/img/@image" class="card-img-top img-fluid" alt="@item.ProductName" onerror="this.onerror=null;this.src='/img/no-image.svg';">
								</div>
								<div class="card-body py-2 px-3">
									<h6 class="card-title mb-1 text-truncate nv-featured-strip-title">@item.ProductName</h6>
									<p class="text-primary fw-bold mb-2 small">@String.Format("{0:N0}", item.Price) đ</p>
								</div>
							</a>
							<div class="card-footer border-0 bg-transparent pt-0 px-3 pb-3 d-flex gap-2">
								<a href="/Cart/Add/@item.ProductId" class="btn btn-primary btn-sm rounded-pill px-3 flex-grow-1" title="Thêm vào giỏ">
									<i class="fa fa-cart-plus me-1"></i> Thêm giỏ
								</a>
								<a href="/Product/Details/@item.ProductId" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Xem chi tiết">
									<i class="fa fa-eye me-1"></i> Xem
								</a>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
		<div class="nv-featured-strip-dots" id="featuredProductsDots" aria-label="Chọn nhóm sản phẩm"></div>
	</div>
</div>

<!-- Hero Start -->
<div class="container-fluid py-5 mb-5 hero-header">

	<div class="container py-5">
		@if (TempData["OrderSuccess"] != null)
		{
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				<i class="fas fa-check-circle me-2"></i>@TempData["OrderSuccess"]
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
			</div>
		}
		@if (TempData["ReferralReward"] != null)
		{
			<div class="alert alert-info alert-dismissible fade show" role="alert">
				<i class="fas fa-gift me-2"></i>@TempData["ReferralReward"]
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
			</div>
		}
		@if (TempData["PaymentMessage"] != null)
		{
			<div class="alert alert-info alert-dismissible fade show" role="alert">
				@TempData["PaymentMessage"]
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
			</div>
		}

		<div class="row g-5 align-items-center">

			<div class="col-md-12 col-lg-7">

				<h4 class="mb-3 text-secondary text-uppercase" style="letter-spacing:.12em;">Tinh hoa đặc sản Việt</h4>

				<h1 class="mb-4 display-3 text-primary">
					Nguồn Việt – Đặc sản vùng miền
				</h1>

				<p class="text-muted mb-4">
					Gửi trọn hương vị quê nhà qua những món quà đậm chất vùng miền – từ trà, cà phê, mắm, bánh đến các loại khô
					được chọn lọc kỹ lưỡng từ những nhà sản xuất địa phương uy tín trên khắp Việt Nam.
				</p>

				<form class="hero-search" method="get" action="/Product">
					<div class="input-group input-group-lg">
						<input class="form-control border-2 border-secondary rounded-pill ps-4 pe-5"
							   type="search"
							   name="q"
							   placeholder="Tìm đặc sản theo tên, vùng miền hoặc địa phương...">
						<button type="submit"
								class="btn btn-primary border-2 border-secondary rounded-pill px-4 hero-search-btn">
							Tìm
						</button>
					</div>
				</form>

			</div>


			<div class="col-md-12 col-lg-5">

				<div id="carouselId"
					 class="carousel slide position-relative"
					 data-bs-ride="carousel">

					<div class="carousel-inner"
						 role="listbox">

						<div class="carousel-item active rounded overflow-hidden">

							<img src="~/img/hero-img-3.jpg"
								 class="img-fluid w-100 bg-secondary rounded-4 object-fit-cover"
								 alt="Đặc sản quà biếu">

							<div class="position-absolute bottom-0 start-0 end-0 p-3 p-md-4">
								<a href="/Product"
								   class="btn btn-warning fw-semibold px-4 py-2 rounded-pill shadow-sm">
									Đặc sản quà biếu
								</a>
							</div>

						</div>


						<div class="carousel-item rounded overflow-hidden">

							<img src="~/img/hero-img-1.jpg"
								 class="img-fluid w-100 rounded-4 object-fit-cover"
								 alt="Đặc sản bếp nhà">

							<div class="position-absolute bottom-0 start-0 end-0 p-3 p-md-4">
								<a href="/Product"
								   class="btn btn-success fw-semibold px-4 py-2 rounded-pill shadow-sm">
									Đặc sản bếp nhà
								</a>
							</div>

						</div>

					</div>


					<button class="carousel-control-prev"
							type="button"
							data-bs-target="#carouselId"
							data-bs-slide="prev">

						<span class="carousel-control-prev-icon"></span>

					</button>


					<button class="carousel-control-next"
							type="button"
							data-bs-target="#carouselId"
							data-bs-slide="next">

						<span class="carousel-control-next-icon"></span>

					</button>

				</div>

			</div>

		</div>

	</div>

</div>
<!-- Hero End -->


@if (Model.JourneySummary != null)
{
	var j = Model.JourneySummary;
	<section class="py-3 py-md-4">
		<div class="container">
			<div class="card border-0 shadow-sm rounded-4 home-journey-card">
				<div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
					<div>
						<div class="d-flex align-items-center gap-2 mb-1">
							<h6 class="mb-0">Tiến độ hành trình 3 miền</h6>
							@if (!string.IsNullOrWhiteSpace(j.JourneyLevelName))
							{
								<span class="badge bg-success-subtle text-success border border-success-subtle small">
									@j.JourneyLevelName
								</span>
							}
						</div>
						<p class="text-muted small mb-2">Khám phá đặc sản Bắc – Trung – Nam để nhận huy hiệu "Trọn vẹn 3 miền".</p>
						<div class="d-flex flex-wrap gap-2 align-items-center">
							<span class="journey-region-pill @(j.HasNorth ? "journey-region-done" : "journey-region-todo")">
								<i class="bi @(j.HasNorth ? "bi-check-circle-fill" : "bi-geo-alt") me-1"></i> Miền Bắc
							</span>
							<span class="journey-region-pill @(j.HasCentral ? "journey-region-done" : "journey-region-todo")">
								<i class="bi @(j.HasCentral ? "bi-check-circle-fill" : "bi-geo-alt") me-1"></i> Miền Trung
							</span>
							<span class="journey-region-pill @(j.HasSouth ? "journey-region-done" : "journey-region-todo")">
								<i class="bi @(j.HasSouth ? "bi-check-circle-fill" : "bi-geo-alt") me-1"></i> Miền Nam
							</span>
							<span class="ms-2 text-muted small">@((j.HasNorth ? 1 : 0) + (j.HasCentral ? 1 : 0) + (j.HasSouth ? 1 : 0))/3 miền</span>
						</div>
					</div>
					<div class="text-md-end">
						@if (j.NextGoals?.Any() ?? false)
						{
							<div class="journey-next-goals small mb-2">
								<strong class="d-block mb-1 text-secondary">Mục tiêu tiếp theo</strong>
								<ul class="list-unstyled mb-0">
									@foreach (var goal in j.NextGoals)
									{
										<li class="mb-1"><i class="bi bi-arrow-right-circle text-primary me-1"></i>@goal</li>
									}
								</ul>
							</div>
						}
						<a href="/Journey" class="btn btn-outline-success btn-sm rounded-pill px-3">
							Xem hành trình
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
}


@if (Model.ActiveVouchers != null && Model.ActiveVouchers.Any())
{
	<!-- Banner voucher dịp khuyến mãi -->
	<section class="py-4 py-md-5 nv-voucher-section" id="voucherSection">
		<div class="container">
			<div class="text-center mb-4">
				<span class="text-light text-uppercase small fw-semibold" style="letter-spacing:.16em;">
					Voucher ưu đãi đang diễn ra
				</span>
				<h2 class="h3 fw-bold text-white mt-2 mb-1">
					Săn quà tặng & mã giảm giá cho từng dịp đặc biệt
				</h2>
				<p class="text-light mb-0" style="opacity:.9;">
					Chọn voucher phù hợp với dịp mua sắm của bạn – nhập mã ở bước thanh toán để được áp dụng ưu đãi.
				</p>
			</div>

			<div class="row g-3 g-md-4">
				@foreach (var v in Model.ActiveVouchers)
				{
					var isPercent = (v.DiscountPercent ?? 0) > 0;
					var discountText = v.IsFreeShipping ? "Free ship" : isPercent
						? $"{v.DiscountPercent}%"
						: (v.DiscountFixed.HasValue ? String.Format("{0:N0} đ", v.DiscountFixed.Value) : "Ưu đãi");
					var minOrderText = v.MinOrderAmount.HasValue ? $"ĐH từ {v.MinOrderAmount.Value.ToString("N0")} đ" : "Không yêu cầu tối thiểu";
					var expiryText = v.ExpiryDate.HasValue ? $"Đến {v.ExpiryDate.Value:dd/MM/yyyy}" : "Không giới hạn thời gian";
					var tag = string.IsNullOrWhiteSpace(v.OccasionTag) ? "Ưu đãi chung" : v.OccasionTag;
				<div class="col-md-6 col-lg-3">
					<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
						<div class="card-body d-flex flex-column p-3 p-md-4">
							<div class="d-flex justify-content-between align-items-start mb-2">
								<span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle small">
									@tag
								</span>
								<span class="badge rounded-pill bg-dark text-warning small">
									@discountText OFF
								</span>
							</div>
							<h5 class="card-title mb-2 text-dark">
								Mã: @v.Code
							</h5>
							@if (!string.IsNullOrWhiteSpace(v.Description))
							{
								<p class="text-muted small mb-2">@v.Description</p>
							}
							<p class="small mb-1">
								<strong>Đơn tối thiểu:</strong> @minOrderText
							</p>
							<p class="small mb-3">
								<strong>Thời gian:</strong> @expiryText
							</p>
							<div class="mt-auto d-flex justify-content-between align-items-center gap-2">
								<small class="text-light-emphasis">
									Sao chép mã và dùng ở bước thanh toán.
								</small>
								<button type="button"
										class="btn btn-sm btn-outline-primary rounded-pill px-3"
										onclick="handleCopyVoucher('@v.Code', @(isLoggedIn ? "true" : "false"))">
									Sao chép
								</button>
							</div>
						</div>
					</div>
				</div>
				}
			</div>
		</div>
	</section>
}

