@section Scripts {
	<script>
		(function () {
			const grid = document.getElementById('featuredGridProducts');
			const pagination = document.getElementById('featuredGridPagination');
			if (!grid || !pagination) return;

			const items = Array.from(grid.querySelectorAll('[data-featured-grid-item]'));
			const prevBtn = document.getElementById('featuredGridPrev');
			const nextBtn = document.getElementById('featuredGridNext');
			const status = document.getElementById('featuredGridStatus');
			let currentPage = 1;

			function getPageSize() {
				if (window.matchMedia('(max-width: 575.98px)').matches) return 3;
				if (window.matchMedia('(max-width: 991.98px)').matches) return 6;
				return 9;
			}

			function renderPage() {
				const pageSize = getPageSize();
				const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
				currentPage = Math.min(Math.max(currentPage, 1), totalPages);
				const start = (currentPage - 1) * pageSize;
				const end = start + pageSize;

				items.forEach(function (item, index) {
					item.hidden = index < start || index >= end;
				});

				pagination.hidden = totalPages <= 1;
				if (status) status.textContent = currentPage + ' / ' + totalPages;
				if (prevBtn) prevBtn.disabled = currentPage <= 1;
				if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
			}

			if (prevBtn) prevBtn.addEventListener('click', function () {
				currentPage -= 1;
				renderPage();
			});
			if (nextBtn) nextBtn.addEventListener('click', function () {
				currentPage += 1;
				renderPage();
			});
			window.addEventListener('resize', function () {
				currentPage = 1;
				renderPage();
			});

			renderPage();
		})();
		// Sao chép mã voucher: yêu cầu đăng nhập nếu chưa có phiên người dùng
		async function handleCopyVoucher(code, isLoggedIn) {
			if (!isLoggedIn) {
				alert('Vui lòng đăng nhập để sao chép và sử dụng mã voucher.');
				return;
			}
			if (!navigator.clipboard) {
				alert('Trình duyệt không hỗ trợ sao chép tự động. Vui lòng chọn và copy mã: ' + code);
				return;
			}
			try {
				await navigator.clipboard.writeText(code);
				alert('Đã sao chép mã ' + code + ' vào bộ nhớ tạm.');
			} catch {
				alert('Không sao chép được. Vui lòng chọn và copy mã: ' + code);
			}
		}

		// Entry banner: hiển thị 1 lần mỗi ngày, đóng bằng X / ESC / click backdrop
		(function () {
			const bannerEl = document.getElementById('nvEntryBanner');
			if (!bannerEl) return;

			const closeBtn = document.getElementById('nvEntryBannerCloseBtn');
			const goHomeBtn = document.getElementById('nvEntryBannerGoHomeBtn');
			const productScroller = bannerEl.querySelector('.nv-entry-banner__products');
			const productItems = Array.from(bannerEl.querySelectorAll('.nv-entry-banner__product-item'));
			const paginationEl = document.getElementById('nvEntryBannerPagination');
			const prevBtn = document.getElementById('nvEntryBannerPrevBtn');
			const nextBtn = document.getElementById('nvEntryBannerNextBtn');
			const pageStatus = document.getElementById('nvEntryBannerPageStatus');
			const storageKey = 'nv_entry_banner_closed_@todayKey';
			let currentPage = 1;
			let pageSize = getPageSize();

			function getPageSize() {
				return window.matchMedia('(max-width: 575.98px)').matches ? 4 : 6;
			}

			function renderProductPage() {
				if (!productItems.length) {
					if (paginationEl) paginationEl.style.display = 'none';
					return;
				}

				pageSize = getPageSize();
				const totalPages = Math.max(1, Math.ceil(productItems.length / pageSize));
				currentPage = Math.min(Math.max(currentPage, 1), totalPages);
				const start = (currentPage - 1) * pageSize;
				const end = start + pageSize;

				productItems.forEach(function (item, index) {
					item.hidden = index < start || index >= end;
				});

				if (paginationEl) paginationEl.style.display = totalPages > 1 ? 'flex' : 'none';
				if (pageStatus) pageStatus.textContent = currentPage + ' / ' + totalPages;
				if (prevBtn) prevBtn.disabled = currentPage <= 1;
				if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
				if (productScroller) productScroller.scrollTop = 0;
			}

			function goToProductPage(delta) {
				currentPage += delta;
				renderProductPage();
			}

			function openBanner() {
				renderProductPage();
				bannerEl.classList.add('is-open');
				bannerEl.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
				document.body.style.overflowX = 'hidden';
			}

			function closeBanner() {
				// Không lưu trạng thái đóng banner nữa để lần sau vào trang vẫn hiện
				// try { localStorage.setItem(storageKey, '1'); } catch (_) { }
				bannerEl.classList.remove('is-open');
				bannerEl.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				document.body.style.overflowX = '';
			}

			function shouldShow() {
				// Luôn hiển thị banner mỗi lần tải trang chủ
				return true;
			}

			document.addEventListener('keydown', function (e) {
				if (e.key === 'Escape' && bannerEl.classList.contains('is-open')) closeBanner();
			});

			bannerEl.addEventListener('click', function (e) {
				const t = e.target;
				if (t && t.getAttribute && t.getAttribute('data-entry-banner-close') === 'backdrop') closeBanner();
			});

			if (closeBtn) closeBtn.addEventListener('click', closeBanner);
			if (goHomeBtn) goHomeBtn.addEventListener('click', closeBanner);
			if (prevBtn) prevBtn.addEventListener('click', function () { goToProductPage(-1); });
			if (nextBtn) nextBtn.addEventListener('click', function () { goToProductPage(1); });
			window.addEventListener('resize', function () {
				const nextPageSize = getPageSize();
				if (nextPageSize !== pageSize) {
					currentPage = 1;
					renderProductPage();
				}
			});

			// Đợi UI sẵn sàng rồi bật banner
			if (shouldShow()) {
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', openBanner);
				} else {
					openBanner();
				}
			}
		})();

		(async function () {
			const statusEl = document.getElementById('locationStatus');
			const debugEl = document.getElementById('locationDebug');
			const btn = document.getElementById('btnLocate');
			const suggestionsEl = document.getElementById('regionSuggestions');
			const mapEl = document.getElementById('map');
			function initNearbyProductsPager() {
				if (!suggestionsEl) return;
				const grid = suggestionsEl.querySelector('[data-nearby-products-grid]');
				const pagination = suggestionsEl.querySelector('[data-nearby-pagination]');
				if (!grid || !pagination) return;
				const items = Array.from(grid.querySelectorAll('[data-nearby-product-item]'));
				const prevBtn = pagination.querySelector('[data-nearby-prev]');
				const nextBtn = pagination.querySelector('[data-nearby-next]');
				const status = pagination.querySelector('[data-nearby-page-status]');
				let currentPage = 1;

				function getPageSize() {
					if (window.matchMedia('(max-width: 575.98px)').matches) return 4;
					if (window.matchMedia('(max-width: 991.98px)').matches) return 5;
					return 6;
				}

				function renderPage() {
					const pageSize = getPageSize();
					const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
					currentPage = Math.min(Math.max(currentPage, 1), totalPages);
					const start = (currentPage - 1) * pageSize;
					const end = start + pageSize;
					items.forEach(function (item, index) {
						item.hidden = index < start || index >= end;
					});
					pagination.hidden = totalPages <= 1;
					if (status) status.textContent = currentPage + ' / ' + totalPages;
					if (prevBtn) prevBtn.disabled = currentPage <= 1;
					if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
				}

				if (prevBtn) prevBtn.onclick = function () {
					currentPage -= 1;
					renderPage();
				};
				if (nextBtn) nextBtn.onclick = function () {
					currentPage += 1;
					renderPage();
				};
				renderPage();
			}
			initNearbyProductsPager();
			const defaultLocation = '@(Model.DefaultRegionLabel ?? "Hà Nội")';

			async function loadDefault() {
				try {
					const res = await fetch(`/Home/RegionSuggestions?location=${encodeURIComponent(defaultLocation)}`, {
						headers: { 'X-Requested-With': 'XMLHttpRequest' }
					});
					if (res.ok) {
						suggestionsEl.innerHTML = await res.text();
						initNearbyProductsPager();
					}
				} catch (_) { }
			}

			if (!mapEl) {
				if (statusEl) statusEl.textContent = `Không tìm thấy vùng hiển thị bản đồ. Đang hiển thị danh sách gợi ý.`;
				await loadDefault();
				return;
			}
			if (!window.L) {
				if (statusEl) statusEl.textContent = `Không tải được bản đồ. Vẫn đang hiển thị danh sách đặc sản gợi ý.`;
				await loadDefault();
				return;
			}
			// Đợi phần tử bản đồ có kích thước (tránh Leaflet tính sai)
			function ensureMapSize(cb) {
				if (mapEl.offsetParent !== null && mapEl.offsetHeight > 0) {
					cb();
					return;
				}
				var attempts = 0;
				var t = setInterval(function () {
					if (mapEl.offsetParent !== null && mapEl.offsetHeight > 0) {
						clearInterval(t);
						cb();
					} else if (++attempts > 50) {
						clearInterval(t);
						cb();
					}
				}, 100);
			}

			// Bản đồ Hà Nội (tương tác) dùng Leaflet + OpenStreetMap, không cần API key.
			const hanoiLatLng = [21.0285, 105.8542];
			let map;
			ensureMapSize(function () {
				map = L.map('map', { zoomControl: true }).setView(hanoiLatLng, 11); // Tâm Hà Nội
				L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
					maxZoom: 19,
					attribution: 'Leaflet | &copy; OpenStreetMap'
				}).addTo(map);
				let marker = L.marker(hanoiLatLng).addTo(map); // Marker mặc định chỉ thẳng vào Hà Nội
				marker.bindPopup('Hà Nội');
				let accuracyCircle = null;
				let clickMarker = null;
				setTimeout(function () {
					if (map && map.invalidateSize) map.invalidateSize();
				}, 100);

				function setStatus(text) {
					if (statusEl) statusEl.textContent = text;
				}
				function setStatusDebug(text) {
					if (debugEl) debugEl.textContent = text ? `[Debug] ${text}` : '';
				}

				async function reverseGeocodeServer(lat, lng) {
					const url = `/Home/ReverseGeocode?lat=${encodeURIComponent(lat)}&lng=${encodeURIComponent(lng)}`;
					const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
					if (!res.ok) throw new Error('reverse geocode failed');
					return await res.json();
				}

				async function loadSuggestions(locationText) {
					if (!suggestionsEl) return;
					const url = `/Home/RegionSuggestions?location=${encodeURIComponent(locationText)}`;
					const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
					if (!res.ok) throw new Error('suggestions failed');
					const html = await res.text();
					suggestionsEl.innerHTML = html;
					initNearbyProductsPager();
				}

				async function loadSuggestionsByLatLng(lat, lng) {
					if (!suggestionsEl) return;
					const url = `/Home/RegionSuggestionsByLatLng?lat=${encodeURIComponent(lat)}&lng=${encodeURIComponent(lng)}`;
					const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
					if (!res.ok) throw new Error('suggestions-latlng failed');
					const html = await res.text();
					suggestionsEl.innerHTML = html;
					initNearbyProductsPager();
				}

				function setUserMarker(lat, lng, accuracyMeters, popupText) {
					if (marker) marker.remove();
					if (accuracyCircle) accuracyCircle.remove();
					accuracyCircle = null;

					marker = L.marker([lat, lng]).addTo(map);
					if (popupText) marker.bindPopup(popupText);

					const acc = Number(accuracyMeters);
					if (Number.isFinite(acc) && acc > 0) {
						accuracyCircle = L.circle([lat, lng], {
							radius: acc,
							color: '#0d6efd',
							weight: 2,
							fillColor: '#0d6efd',
							fillOpacity: 0.12
						}).addTo(map);
					}

					try {
						map.flyTo([lat, lng], 16, { animate: true, duration: 0.45 });
					} catch (_) {
						map.setView([lat, lng], 16);
					}
				}

				async function locate() {
					setStatusDebug('');
					if (!navigator.geolocation) {
						setStatus('Trình duyệt không hỗ trợ định vị. Đang thử định vị theo IP...');
						await locateByIp();
						return;
					}

					// Geolocation trên trình duyệt thường yêu cầu HTTPS (trừ localhost)
					const host = (location.hostname || '').toLowerCase();
					const isLocalhostLike = host === 'localhost' || host === '127.0.0.1' || host === '::1';
					if (location.protocol !== 'https:' && !isLocalhostLike) {
						setStatus('Không thể lấy GPS vì trang chưa chạy HTTPS (hoặc chưa phải localhost). Đang thử định vị theo IP (ước lượng)...');
						await locateByIp();
						return;
					}

					// Nếu đã bị từ chối quyền vị trí, khỏi chờ GPS, chuyển sang IP fallback ngay
					try {
						if (navigator.permissions?.query) {
							const p = await navigator.permissions.query({ name: 'geolocation' });
							if (p?.state === 'denied') {
								setStatus('Bạn đã từ chối quyền vị trí cho trang này. Hãy bật lại trong cài đặt trình duyệt, hoặc dùng định vị theo IP (ước lượng)...');
								await locateByIp();
								return;
							}
						}
					} catch (_) { }

					if (btn) {
						btn.disabled = true;
						btn.classList.add('disabled');
					}

					setStatus('Đang lấy vị trí (GPS)...');
					try {
						const h = (location.hostname || '').toLowerCase();
						setStatusDebug(`secureContext=${String(window.isSecureContext)} protocol=${location.protocol} host=${h} ua=${(navigator.userAgent || '').slice(0, 60)}...`);
					} catch (_) { }

					// Lấy nhiều mẫu để tránh vị trí thô/cached; chọn mẫu có accuracy tốt nhất.
					let best = null; // { lat, lng, accuracy }
					const startedAt = Date.now();
					const goodAccuracyMeters = 80;
					const usableAccuracyMeters = 1000;
					const maxWaitMs = 30000;
					let watchId = null;
					let finalized = false;

					function finish() {
						if (watchId != null) {
							try { navigator.geolocation.clearWatch(watchId); } catch (_) { }
							watchId = null;
						}
						if (btn) {
							btn.disabled = false;
							btn.classList.remove('disabled');
						}
					}

					async function finalizeBest() {
						if (finalized) return;
						finalized = true;
						finish();
						if (!best) {
							await onErr({ code: 3, message: 'no best position' });
							return;
						}
						try {
							const acc = best?.accuracy;
							const accText = Number.isFinite(acc) ? `±${Math.round(acc)}m` : 'không rõ';
							setStatus(`Đang tải đặc sản theo tọa độ... [${best.lat.toFixed(6)}, ${best.lng.toFixed(6)} ${accText}]`);
							setUserMarker(best.lat, best.lng, best.accuracy, 'Vị trí của bạn');
							await loadSuggestionsByLatLng(best.lat, best.lng);

							try {
								const data = await reverseGeocodeServer(best.lat, best.lng);
								const locationText = data.location || 'Khu vực của bạn';
								const lowQuality = Number.isFinite(acc) && acc >= usableAccuracyMeters;
								setStatus(`Vị trí: ${locationText} (${accText})${lowQuality ? ' — độ chính xác thấp, hãy bật “Vị trí chính xác”/Wi‑Fi và thử lại.' : ''} [${best.lat.toFixed(6)}, ${best.lng.toFixed(6)}]`);
								setUserMarker(best.lat, best.lng, best.accuracy, locationText);
							} catch (_) { }
						} catch (e) {
							setStatus(`Không thể tải đặc sản theo tọa độ. Đang hiển thị mặc định: ${defaultLocation}`);
							await loadDefault();
						}
					}

					function shouldFinalize() {
						if (!best) return false;
						if (best.accuracy <= goodAccuracyMeters) return true;
						// chờ vài giây để GPS ổn định rồi chốt vị trí tốt nhất đang có
						if (best.accuracy <= usableAccuracyMeters && Date.now() - startedAt >= 12000) return true;
						return false;
					}

					const onPos = async (pos) => {
						if (finalized) return;
						const lat = pos.coords.latitude;
						const lng = pos.coords.longitude;
						const accuracy = Number(pos.coords.accuracy);

						const acc = (Number.isFinite(accuracy) && accuracy > 0) ? accuracy : Infinity;
						if (!best || acc < best.accuracy) best = { lat, lng, accuracy: acc };

						const accText = Number.isFinite(accuracy) ? `~${Math.round(accuracy)}m` : 'không rõ';
						setStatus(`Đang lấy vị trí (độ chính xác ${accText})...`);

						// show live marker để người dùng thấy map đang cập nhật
						setUserMarker(lat, lng, accuracy, 'Vị trí của bạn');

						if (!shouldFinalize()) return;
						await finalizeBest();
					};

					const onErr = async (err) => {
						if (finalized) return;
						finalized = true;
						finish();
						// err.code: 1=PERMISSION_DENIED, 2=POSITION_UNAVAILABLE, 3=TIMEOUT
						const code = Number(err?.code);
						const msg = (err && typeof err.message === 'string') ? err.message : '';
						if (code === 1) {
							setStatus('Bạn đã từ chối quyền vị trí cho trang này. Hãy bấm biểu tượng ổ khóa trên thanh địa chỉ → Site settings → Location → Allow, hoặc bật lại Location trong Windows. Đang thử định vị theo IP (ước lượng)...');
						} else if (code === 2) {
							setStatus('Thiết bị/trình duyệt không thể xác định vị trí (POSITION_UNAVAILABLE). Hãy bật Location trong Windows, bật Wi‑Fi, hoặc bật “Vị trí chính xác” trên thiết bị. Đang thử định vị theo IP (ước lượng)...');
						} else if (code === 3) {
							setStatus('Định vị GPS bị timeout. Hãy thử lại sau vài giây, hoặc bật Location/Wi‑Fi để tăng khả năng định vị. Đang thử định vị theo IP (ước lượng)...');
						} else {
							setStatus('Không lấy được GPS (có thể bạn chưa cho phép quyền hoặc thiết bị không bật dịch vụ vị trí). Đang thử định vị theo IP (ước lượng)...');
						}
						try { setStatusDebug(`geo_error code=${String(code || 'n/a')} message=${msg || 'n/a'}`); } catch (_) { }
						await locateByIp();
					};

					const opts = { enableHighAccuracy: true, timeout: 25000, maximumAge: 0 };
					try {
						watchId = navigator.geolocation.watchPosition(onPos, function (err) {
							try { setStatusDebug(`geo_watch_error code=${String(err?.code || 'n/a')} message=${err?.message || 'n/a'}`); } catch (_) { }
						}, opts);
					} catch (_) { }
					// getCurrentPosition trước để Edge chắc chắn prompt + trả tọa độ 1 lần
					try {
						const firstPos = await new Promise((resolve, reject) => {
							navigator.geolocation.getCurrentPosition(resolve, reject, opts);
						});
						await onPos(firstPos);
					} catch (e) {
						if (watchId == null) {
							await onErr(e);
							return;
						}
						try { setStatusDebug(`geo_current_error code=${String(e?.code || 'n/a')} message=${e?.message || 'n/a'}`); } catch (_) { }
					}

					// Nếu quá lâu vẫn chưa chốt, chốt theo best hiện có (nếu có)
					setTimeout(function () {
						if (finalized) return;
						if (watchId != null) {
							try { navigator.geolocation.clearWatch(watchId); } catch (_) { }
							watchId = null;
						}
						(async function () {
							if (best) await finalizeBest();
							else await onErr({ code: 3, message: 'timeout' });
						})();
					}, maxWaitMs);
				}

				async function locateByIp() {
					try {
						// Dùng GeoIP server-side để tránh Edge Tracking Prevention/CORS/rate-limit phía client
						const res = await fetch('/Home/GeoIp', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
						if (!res.ok) throw new Error(`geoip ${res.status}`);
						const data = await res.json();
						const lat = data?.lat;
						const lng = data?.lng;
						const location = data?.location;

						if (lat && lng) {
							setUserMarker(lat, lng, null, location || 'Vị trí (ước lượng)');
							map.setView([lat, lng], 16);
						}

						if (lat && lng) {
							setStatus(`Vị trí (ước lượng theo IP). Đang tải đặc sản theo tọa độ... [${Number(lat).toFixed(6)}, ${Number(lng).toFixed(6)}]`);
							await loadSuggestionsByLatLng(lat, lng);
							if (location) setStatus(`Vị trí (ước lượng theo IP): ${location} [${Number(lat).toFixed(6)}, ${Number(lng).toFixed(6)}]`);
						} else if (location) {
							setStatus(`Vị trí (ước lượng theo IP): ${location}`);
							await loadSuggestions(location);
						} else {
							setStatus(`Không thể định vị theo IP. Đang hiển thị mặc định: ${defaultLocation}`);
							await loadDefault();
						}
					} catch (e) {
						setStatus(`Không thể định vị theo IP. Đang hiển thị mặc định: ${defaultLocation}`);
						await loadDefault();
					}
				}

				if (btn) btn.addEventListener('click', locate);

				map.on('click', async function (e) {
					const lat = e.latlng.lat;
					const lng = e.latlng.lng;
					if (clickMarker) clickMarker.remove();
					clickMarker = L.circleMarker([lat, lng], { radius: 8, color: '#0d6efd' }).addTo(map);
					try {
						setStatus(`Đang tải đặc sản theo điểm bạn chọn... [${lat.toFixed(6)}, ${lng.toFixed(6)}]`);
						await loadSuggestionsByLatLng(lat, lng);
						try {
							const data = await reverseGeocodeServer(lat, lng);
							const locationText = data.location || 'Khu vực bạn chọn';
							setStatus(`Khu vực đã chọn: ${locationText} [${lat.toFixed(6)}, ${lng.toFixed(6)}]`);
						} catch (_) { }
					} catch (e2) {
						setStatus(`Không thể tải đặc sản theo điểm bạn chọn. Đang hiển thị mặc định: ${defaultLocation}`);
						await loadDefault();
					}
				});

				loadDefault();
			});
		})();
	</script>
}


