@model EXE.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết sản phẩm";
    var image = Model.ProductImages?.FirstOrDefault()?.ImageUrl ?? "no-image.svg";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Chi tiết sản phẩm</h2>
            <div class="text-muted">#@Model.ProductId - @Model.ProductName</div>
        </div>
        <div class="d-flex gap-2 flex-wrap justify-content-end">
            @if (Model.ApprovalStatus != "Approved")
            {
                <form method="post" action="/ProductAdmin/Approve/@Model.ProductId" class="d-inline">
                    <button type="submit" class="btn btn-success rounded-pill px-4">Duyệt</button>
                </form>
            }
            @if (Model.ApprovalStatus != "Rejected")
            {
                <form method="post" action="/ProductAdmin/Reject/@Model.ProductId" class="d-inline" onsubmit="return confirm('Từ chối sản phẩm này?');">
                    <button type="submit" class="btn btn-warning rounded-pill px-4">Từ chối</button>
                </form>
            }
            <a href="/ProductAdmin" class="btn btn-outline-secondary rounded-pill px-4">Quay lại</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="border rounded-3 bg-white p-3">
                <img src="~/img/@image" alt="@Model.ProductName" class="img-fluid rounded-3 w-100" style="max-height:360px;object-fit:cover;" onerror="this.onerror=null;this.src='/img/no-image.svg';">
            </div>
        </div>
        <div class="col-lg-7">
            <div class="border rounded-3 bg-white p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Seller</dt>
                    <dd class="col-sm-8">@(Model.Seller?.FullName ?? "N/A")</dd>

                    <dt class="col-sm-4">Danh mục</dt>
                    <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "N/A")</dd>

                    <dt class="col-sm-4">Vùng miền</dt>
                    <dd class="col-sm-8">@(Model.Region?.RegionName ?? "N/A")</dd>

                    <dt class="col-sm-4">Giá</dt>
                    <dd class="col-sm-8">@String.Format("{0:N0}", Model.Price ?? 0) đ</dd>

                    <dt class="col-sm-4">Tồn kho</dt>
                    <dd class="col-sm-8">@((Model.Stock ?? 0))</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">@(Model.ApprovalStatus ?? "Pending")</dd>

                    <dt class="col-sm-4">Ngày tạo</dt>
                    <dd class="col-sm-8">@(Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>

                    <dt class="col-sm-4">Nguồn gốc</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.OriginProofImageUrl))
                        {
                            <a href="/img/@Model.OriginProofImageUrl" target="_blank">Xem ảnh chứng minh</a>
                        }
                        else
                        {
                            <span class="text-muted">Không có</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Mô tả</dt>
                    <dd class="col-sm-8">@Model.Description</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
