@model EXE.Models.Product
@using EXE.Controllers

@{
	ViewData["Title"] = "Đăng sản phẩm";
	var categories = ViewBag.Categories as List<EXE.Models.Category> ?? new();
	var regions = ViewBag.Regions as List<EXE.Models.Region> ?? new();
	var adPackages = ViewBag.AdPackages as List<SellerController.AdvertisingPackageOption> ?? new();
}

<div class="container-fluid page-header py-5">
	<h1 class="text-center text-white display-6">Đăng sản phẩm</h1>
</div>

<div class="container-fluid py-5">
	<div class="container">
		<style>
			.nv-form-card { border: 1px solid rgba(148,163,184,.35); border-radius: 8px; background: #fff; box-shadow: 0 .125rem .35rem rgba(15,23,42,.06); }
			.nv-form-card .form-control, .nv-form-card .form-select { border-radius: 8px; }
			.nv-side-note { border-radius: 8px; background: rgba(13,110,253,.06); border: 1px solid rgba(13,110,253,.14); }
			.nv-ad-note { border-radius: 8px; background: rgba(255,193,7,.1); border: 1px solid rgba(255,193,7,.35); }
			.nv-qr-box { border-radius: 8px; background: #fff; border: 1px solid rgba(148,163,184,.35); padding: 12px; }
			.nv-qr-img { width: 100%; max-width: 220px; aspect-ratio: 1; object-fit: contain; display: block; margin: 0 auto; border-radius: 8px; background: #f8fafc; border: 1px solid rgba(148,163,184,.25); }
			.nv-transfer-check { border-radius: 8px; background: rgba(25,135,84,.08); border: 1px solid rgba(25,135,84,.25); padding: 10px 12px; }
		</style>

		<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
			<div>
				<div class="text-primary text-uppercase small fw-semibold">Sản phẩm mới</div>
				<h2 class="mb-1">Thông tin đăng bán</h2>
				<p class="text-muted mb-0">Sản phẩm sẽ được gửi admin kiểm duyệt trước khi hiển thị trên sàn.</p>
			</div>
			<a href="/Seller" class="btn btn-outline-secondary rounded-pill px-4">
				<i class="fas fa-arrow-left me-2"></i>Quay lại
			</a>
		</div>

		@if (!string.IsNullOrWhiteSpace(ViewBag.Error))
		{
			<div class="alert alert-danger border-0 shadow-sm">@ViewBag.Error</div>
		}

		<form method="post" enctype="multipart/form-data" class="nv-form-card p-4 p-md-5">
			<div class="row g-4">
				<div class="col-lg-8">
					<div class="mb-3">
						<label class="form-label fw-semibold">Tên sản phẩm</label>
						<input name="ProductName" value="@Model.ProductName" class="form-control" placeholder="Ví dụ: Trà sen Tây Hồ" required>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold">Mô tả</label>
						<textarea name="Description" class="form-control" rows="6" placeholder="Nguồn gốc, quy cách đóng gói, hương vị, cách bảo quản...">@Model.Description</textarea>
					</div>
					<div class="row g-3">
						<div class="col-md-4">
							<label class="form-label fw-semibold">Giá bán</label>
							<input name="Price" type="number" min="0" step="1000" value="@(Model.Price ?? 0)" class="form-control" required>
						</div>
						<div class="col-md-4">
							<label class="form-label fw-semibold">Tồn kho</label>
							<input name="Stock" type="number" min="0" step="1" value="@(Model.Stock ?? 0)" class="form-control">
						</div>
						<div class="col-md-4">
							<label class="form-label fw-semibold">Ảnh sản phẩm</label>
							<input type="file" name="imageFile" accept="image/*" class="form-control">
						</div>
					</div>
					<div class="mt-3">
						<label class="form-label fw-semibold">Ảnh chứng minh nguồn gốc xuất xứ <span class="text-danger">*</span></label>
						<input type="file" name="originProofFile" accept="image/*" class="form-control" required>
						<div class="form-text">Có thể là giấy chứng nhận, hóa đơn nhập hàng, tem truy xuất, ảnh bao bì hoặc chứng từ liên quan.</div>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="mb-3">
						<label class="form-label fw-semibold">Danh mục</label>
						<select name="CategoryId" class="form-select">
							<option value="">-- Chọn danh mục --</option>
							@foreach (var c in categories)
							{
								<option value="@c.CategoryId" selected="@(c.CategoryId == Model.CategoryId)">@c.CategoryName</option>
							}
						</select>
					</div>
					<div class="mb-3">
						<label class="form-label fw-semibold">Vùng miền</label>
						<select name="RegionId" class="form-select">
							<option value="">-- Chọn vùng --</option>
							@foreach (var r in regions)
							{
								<option value="@r.RegionId" selected="@(r.RegionId == Model.RegionId)">@r.RegionName (@r.Province)</option>
							}
						</select>
					</div>
					<div class="nv-side-note p-3">
						<div class="fw-semibold mb-2"><i class="fas fa-shield-alt me-2 text-primary"></i>Kiểm duyệt sản phẩm</div>
						<div class="text-muted small">Sau khi gửi, sản phẩm ở trạng thái chờ duyệt. Admin xác minh thông tin và ảnh nguồn gốc trước khi cho lên sàn.</div>
					</div>
					<div class="nv-ad-note p-3 mt-3">
						<div class="fw-semibold mb-2"><i class="fas fa-bullhorn me-2 text-warning"></i>Nạp tiền quảng cáo</div>
						<label class="form-label small fw-semibold">Chọn gói quảng cáo</label>
						<select name="advertisingPackageCode" class="form-select js-ad-package">
							@foreach (var package in adPackages)
							{
								<option value="@package.Code" data-price="@package.Price">
									@package.Name - @String.Format("{0:N0}", package.Price) đ@(package.Days > 0 ? $" / {package.Days} ngày" : "")
								</option>
							}
						</select>
						<div class="form-text">Gói có phí sẽ đưa sản phẩm vào banner, thanh quảng cáo và khu sản phẩm quảng cáo trên trang chủ sau khi được duyệt. Chọn “Không quảng cáo” để chỉ bán bình thường trên sàn.</div>
						<div class="small bg-white rounded border p-2 mt-3">
							Sau khi gửi sản phẩm, hệ thống sẽ tạo mã VietQR riêng cho yêu cầu quảng cáo để người bán thanh toán.
						</div>
					</div>
				</div>
			</div>
			<div class="d-flex justify-content-end mt-4">
				<button type="submit" class="btn btn-primary rounded-pill px-5 py-2 js-submit-btn">
					<i class="fas fa-paper-plane me-2"></i>Gửi duyệt
				</button>
			</div>
		</form>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		const packageSelect = document.querySelector('.js-ad-package');
		packageSelect?.addEventListener('change', function () {});
	});
</script>
