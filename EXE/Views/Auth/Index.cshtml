<form method="post">

	<div class="container mt-5">

		<h2>Đăng nhập</h2>

		<input name="email"
			   class="form-control"
			   placeholder="Email">

		<input name="password"
			   class="form-control mt-2"
			   placeholder="Mật khẩu">

		<button class="btn btn-primary mt-3">

			Đăng nhập

		</button>

		<p class="text-danger">

			@ViewBag.Error

		</p>

	</div>

</form>
