@model EXE.Models.Order

@{
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
	ViewData["Title"] = "Chi tiết đơn hàng";
	var allStatuses = ViewBag.Statuses as List<EXE.Models.OrderStatus> ?? new();
}

<div class="container-fluid py-3">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="mb-0">Chi tiết đơn hàng #@Model.OrderId</h2>
		<a href="/OrderAdmin" class="btn btn-outline-secondary rounded-pill px-4">Quay lại danh sách</a>
	</div>

	<div class="row g-4 mb-4">
		<div class="col-lg-6">
			<div class="bg-white rounded p-4 shadow-sm">
				<h5 class="mb-3">Thông tin khách hàng</h5>
				<p class="mb-1"><strong>Khách:</strong> @(Model.User?.FullName ?? Model.User?.Email ?? "Khách lẻ")</p>
				<p class="mb-1"><strong>Email:</strong> @Model.User?.Email</p>
				<p class="mb-1"><strong>Ngày đặt:</strong> @(Model.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "")</p>
				<p class="mb-0"><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="bg-white rounded p-4 shadow-sm">
				<h5 class="mb-3">Trạng thái & tổng tiền</h5>
				<p class="mb-2">
					<strong>Trạng thái hiện tại:</strong>
					<span class="badge bg-secondary">@Model.Status?.StatusName</span>
				</p>
				<p class="mb-4">
					<strong>Tổng tiền:</strong>
					@String.Format("{0:N0}", Model.TotalAmount ?? 0) đ
				</p>
				<p class="mb-4">
					<strong>Thanh toán:</strong>
					@if (Model.Payments.Any())
					{
						var payment = Model.Payments.OrderByDescending(p => p.PaymentDate).First();
						<span class="badge bg-success">Đã nhận @payment.PaymentMethod?.MethodName</span>
					}
					else
					{
						<span class="badge bg-warning text-dark">Chờ thanh toán</span>
					}
				</p>
				<form method="post" action="/OrderAdmin/UpdateStatus/@Model.OrderId" class="d-flex align-items-center gap-2">
					<select name="statusId" class="form-select w-auto">
						@foreach (var s in allStatuses)
						{
							<option value="@s.StatusId" selected="@(s.StatusId == Model.StatusId)">
								@s.StatusName
							</option>
						}
					</select>
					<button type="submit" class="btn btn-primary rounded-pill px-4">Cập nhật</button>
				</form>
			</div>
		</div>
	</div>

	<div class="bg-white rounded p-4 shadow-sm">
		<h5 class="mb-3">Danh sách sản phẩm</h5>
		<div class="table-responsive">
			<table class="table mb-0">
				<thead class="table-light">
					<tr>
						<th>Sản phẩm</th>
						<th class="text-center" style="width:100px;">SL</th>
						<th class="text-end" style="width:140px;">Đơn giá</th>
						<th class="text-end" style="width:160px;">Thành tiền</th>
					</tr>
				</thead>
				<tbody>
					@if (!Model.OrderItems.Any())
					{
						<tr>
							<td colspan="4" class="text-center py-4 text-muted">Đơn hàng không có sản phẩm.</td>
						</tr>
					}
					else
					{
						@foreach (var it in Model.OrderItems)
						{
							var name = it.Product?.ProductName ?? $"SP #{it.ProductId}";
							var qty = it.Quantity ?? 0;
							var price = it.Price ?? 0;
							var line = price * qty;
							<tr>
								<td>@name</td>
								<td class="text-center">@qty</td>
								<td class="text-end">@String.Format("{0:N0}", price) đ</td>
								<td class="text-end">@String.Format("{0:N0}", line) đ</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

