@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Bảng điều khiển";
    int productCount = ViewBag.ProductCount ?? 0;
    int categoryCount = ViewBag.CategoryCount ?? 0;
    int orderCount = ViewBag.OrderCount ?? 0;
    int userCount = ViewBag.UserCount ?? 0;
    int totalVisits = ViewBag.TotalVisits ?? 0;
    int todayVisits = ViewBag.TodayVisits ?? 0;
    int uniqueVisitors = ViewBag.UniqueVisitors ?? 0;
    int productViews = ViewBag.ProductViews ?? 0;
    string chartLabelsJson = ViewBag.ChartLabelsJson ?? "[]";
    string trafficDataJson = ViewBag.TrafficDataJson ?? "[]";
    string revenueDataJson = ViewBag.RevenueDataJson ?? "[]";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1">Bảng điều khiển quản trị</h2>
            <p class="text-muted mb-0">Tổng quan nhanh về sản phẩm, danh mục, đơn hàng và người dùng.</p>
        </div>
        <a href="/ProductAdmin" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-box-open me-2"></i>Quản lý sản phẩm
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Sản phẩm</div>
                    <div class="h3 mb-0">@productCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Danh mục</div>
                    <div class="h3 mb-0">@categoryCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Đơn hàng</div>
                    <div class="h3 mb-0">@orderCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Người dùng</div>
                    <div class="h3 mb-0">@userCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Tổng lượt truy cập</div>
                    <div class="h3 mb-0">@totalVisits</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Lượt truy cập hôm nay</div>
                    <div class="h3 mb-0">@todayVisits</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Khách truy cập duy nhất</div>
                    <div class="h3 mb-0">@uniqueVisitors</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Lượt xem sản phẩm</div>
                    <div class="h3 mb-0">@productViews</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">Lượt truy cập trang web</h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle small">
                            14 ngày gần nhất
                        </span>
                    </div>
                    <p class="text-muted small mb-3">
                        Số lượt truy cập thật theo từng ngày, không tính AJAX hay route nội bộ.
                    </p>
                    <canvas id="trafficChart" style="max-height: 260px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">Doanh thu theo ngày</h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                            14 ngày gần nhất
                        </span>
                    </div>
                    <p class="text-muted small mb-3">
                        Tổng doanh thu mỗi ngày từ các đơn hàng đã hoàn thành.
                    </p>
                    <canvas id="revenueChart" style="max-height: 260px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Quản lý sản phẩm</h5>
                    <p class="card-text text-muted small">
                        Thêm, sửa, xóa sản phẩm và hình ảnh.
                    </p>
                    <a href="/ProductAdmin" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Đi tới quản lý sản phẩm
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Quản lý danh mục</h5>
                    <p class="card-text text-muted small">
                        Tổ chức danh mục đặc sản theo nhóm, vùng.
                    </p>
                    <a href="/CategoryAdmin" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Đi tới quản lý danh mục
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Quản lý đơn hàng</h5>
                    <p class="card-text text-muted small">
                        Theo dõi đơn hàng mới và cập nhật trạng thái.
                    </p>
                    <a href="/OrderAdmin" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Đi tới quản lý đơn hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const chartLabels = @Html.Raw(chartLabelsJson);
        const trafficData = @Html.Raw(trafficDataJson);
        const revenueData = @Html.Raw(revenueDataJson);

        const trafficCtx = document.getElementById('trafficChart');
        if (trafficCtx && Array.isArray(chartLabels) && Array.isArray(trafficData)) {
            new Chart(trafficCtx, {
                type: 'line',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Lượt truy cập',
                        data: trafficData,
                        borderColor: '#22c55e',
                        backgroundColor: 'rgba(34, 197, 94, 0.12)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 3,
                        pointBackgroundColor: '#16a34a'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }

        const revenueCtx = document.getElementById('revenueChart');
        if (revenueCtx && Array.isArray(chartLabels) && Array.isArray(revenueData)) {
            new Chart(revenueCtx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: revenueData,
                        backgroundColor: 'rgba(59, 130, 246, 0.6)',
                        borderColor: '#3b82f6',
                        borderWidth: 1.5,
                        borderRadius: 6,
                        maxBarThickness: 32
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const value = context.parsed.y || 0;
                                    return 'Doanh thu: ' + value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
}
