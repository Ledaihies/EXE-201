@model EXE.Models.Product

@{
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
	ViewData["Title"] = "Thêm sản phẩm";
	var categories = ViewBag.Categories as List<EXE.Models.Category> ?? new();
	var regions = ViewBag.Regions as List<EXE.Models.Region> ?? new();
}

<div class="container-fluid py-3">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="mb-0">Thêm sản phẩm</h2>
		<a href="/ProductAdmin" class="btn btn-outline-secondary rounded-pill px-4">Quay lại</a>
	</div>

	<form method="post" enctype="multipart/form-data" class="bg-white p-4 rounded shadow-sm">
		<div class="row g-4">
			<div class="col-lg-8">
				<div class="mb-3">
					<label class="form-label">Tên sản phẩm</label>
					<input name="ProductName" class="form-control" placeholder="Ví dụ: Trà sen Tây Hồ" required />
				</div>

				<div class="mb-3">
					<label class="form-label">Mô tả</label>
					<textarea name="Description" class="form-control" rows="5" placeholder="Mô tả ngắn gọn, hấp dẫn..."></textarea>
				</div>

				<div class="row g-3">
					<div class="col-md-4">
						<label class="form-label">Giá (đ)</label>
						<input name="Price" type="number" min="0" step="1000" class="form-control" placeholder="159000" required />
					</div>
					<div class="col-md-4">
						<label class="form-label">Tồn kho</label>
						<input name="Stock" type="number" min="0" step="1" class="form-control" placeholder="50" />
					</div>
					<div class="col-md-4">
						<label class="form-label">Ảnh sản phẩm</label>
						<input type="file" name="imageFile" accept="image/*" class="form-control" />
					</div>
				</div>
			</div>

			<div class="col-lg-4">
				<div class="mb-3">
					<label class="form-label">Danh mục</label>
					<select name="CategoryId" class="form-select">
						<option value="">-- Chọn danh mục --</option>
						@foreach (var c in categories)
						{
							<option value="@c.CategoryId">@c.CategoryName</option>
						}
					</select>
				</div>

				<div class="mb-3">
					<label class="form-label">Vùng miền</label>
					<select name="RegionId" class="form-select">
						<option value="">-- Chọn vùng --</option>
						@foreach (var r in regions)
						{
							<option value="@r.RegionId">@r.RegionName (@r.Province)</option>
						}
					</select>
				</div>

				<div class="alert alert-info mb-0">
					<strong>Tip:</strong> Bạn có thể thêm nhiều ảnh bằng cách sửa sản phẩm sau khi tạo.
				</div>
			</div>
		</div>

		<div class="d-flex justify-content-end mt-4">
			<button type="submit" class="btn btn-primary rounded-pill px-5">Lưu</button>
		</div>
	</form>
</div>